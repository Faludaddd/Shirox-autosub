<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Entitlements for the ShiroxWidgets Widget Extension target.

		This file is a TEMPLATE — no Xcode target references it yet (the
		project has no Widget Extension target; see Shirox/Widgets/README.md).
		When a developer adds the Widget Extension target in Xcode, they should
		point its `CODE_SIGN_ENTITLEMENTS` build setting at this file so the
		extension is admitted to the same App Group as the main app.

		The App Group identifier MUST match:
		  • `ShiroxWidgetConfig.appGroup` in ShiroxWidgets.swift
		  • the entry in Shirox/Shirox.entitlements (the main app's entitlements)
		If they drift, the widget extension will silently fail to read shared
		UserDefaults (`group.com.shirox.app`) and the Continue Watching widget
		will always show its empty placeholder.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.shirox.app</string>
	</array>
</dict>
</plist>
